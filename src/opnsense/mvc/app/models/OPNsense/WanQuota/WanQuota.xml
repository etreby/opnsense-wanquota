            <provider1_quota_gb type="NumericField">
                <Default>100</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100000</MaximumValue>
            </provider1_quota_gb>
            <provider1_cycle_day type="NumericField">
                <Default>1</Default>
