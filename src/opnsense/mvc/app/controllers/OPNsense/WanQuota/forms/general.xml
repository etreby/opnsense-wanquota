<form>
    <field>
        <id>wanquota.general.enabled</id>
        <label>Enable WAN quota reporting</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>wanquota.general.provider1_enabled</id><label>Enable provider 1</label><type>checkbox</type>
    </field>
    <field>
        <id>wanquota.general.provider1_name</id>
        <label>Provider 1 name</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.provider1_interface</id>
        <label>Provider 1 interface</label>
        <type>dropdown</type>
    </field>
    <field>
        <id>wanquota.general.provider1_quota_gb</id>
        <label>Provider 1 quota (decimal GB)</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.provider1_cycle_day</id>
        <label>Provider 1 billing-cycle day</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.provider1_warning_percent</id>
        <label>Provider 1 warning threshold (%)</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.provider2_enabled</id><label>Enable provider 2</label><type>checkbox</type>
    </field>
    <field>
        <id>wanquota.general.provider2_name</id>
        <label>Provider 2 name</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.provider2_interface</id>
        <label>Provider 2 interface</label>
        <type>dropdown</type>
    </field>
    <field>
        <id>wanquota.general.provider2_quota_gb</id>
        <label>Provider 2 quota (decimal GB)</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.provider2_cycle_day</id>
        <label>Provider 2 billing-cycle day</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.provider2_warning_percent</id>
        <label>Provider 2 warning threshold (%)</label>
        <type>text</type>
    </field>
    <field><id>wanquota.general.provider3_enabled</id><label>Enable provider 3</label><type>checkbox</type></field>
    <field><id>wanquota.general.provider3_name</id><label>Provider 3 name</label><type>text</type></field>
    <field><id>wanquota.general.provider3_interface</id><label>Provider 3 interface</label><type>dropdown</type></field>
    <field><id>wanquota.general.provider3_quota_gb</id><label>Provider 3 quota (decimal GB)</label><type>text</type></field>
    <field><id>wanquota.general.provider3_cycle_day</id><label>Provider 3 billing-cycle day</label><type>text</type></field>
    <field><id>wanquota.general.provider3_warning_percent</id><label>Provider 3 warning threshold (%)</label><type>text</type></field>
    <field><id>wanquota.general.provider4_enabled</id><label>Enable provider 4</label><type>checkbox</type></field>
    <field><id>wanquota.general.provider4_name</id><label>Provider 4 name</label><type>text</type></field>
    <field><id>wanquota.general.provider4_interface</id><label>Provider 4 interface</label><type>dropdown</type></field>
    <field><id>wanquota.general.provider4_quota_gb</id><label>Provider 4 quota (decimal GB)</label><type>text</type></field>
    <field><id>wanquota.general.provider4_cycle_day</id><label>Provider 4 billing-cycle day</label><type>text</type></field>
    <field><id>wanquota.general.provider4_warning_percent</id><label>Provider 4 warning threshold (%)</label><type>text</type></field>
    <field>
        <id>wanquota.general.consumers_enabled</id>
        <label>Enable consumer reporting</label>
        <type>checkbox</type>
        <help>Rank LAN hosts using the persistent OPNsense Insight daily-flow database.</help>
    </field>
    <field>
        <id>wanquota.general.domain_enabled</id>
        <label>Enable domain attribution</label>
        <type>checkbox</type>
        <help>Correlate Insight flow bytes with recently observed Unbound DNS answers. Results are attributed estimates.</help>
    </field>
    <field>
        <id>wanquota.general.top_limit</id>
        <label>Top results</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.default_period</id>
        <label>Default consumer period</label>
        <type>dropdown</type>
    </field>
    <field>
        <id>wanquota.general.domain_retention_days</id>
        <label>DNS attribution retention (days)</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.alerts_enabled</id>
        <label>Enable quota alerts</label>
        <type>checkbox</type>
        <help>Write deduplicated threshold and projection alerts to the system log.</help>
    </field>
    <field>
        <id>wanquota.general.projection_alert_enabled</id>
        <label>Alert when projected usage exceeds quota</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>wanquota.general.alert_repeat_hours</id>
        <label>Alert repeat interval (hours)</label>
        <type>text</type>
    </field>
</form>
