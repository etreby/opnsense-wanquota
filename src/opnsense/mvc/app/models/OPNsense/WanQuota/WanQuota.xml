<model>
    <mount>//OPNsense/WanQuota</mount>
    <description>WAN quota reporting configuration</description>
    <version>1.3.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <provider1_enabled type="BooleanField"><Default>1</Default><Required>Y</Required></provider1_enabled>
            <provider1_name type="TextField">
                <Default>ISP 1</Default>
                <Required>Y</Required>
            </provider1_name>
            <provider1_interface type="InterfaceField">
                <Default>wan</Default>
                <Required>Y</Required>
            </provider1_interface>
            <provider1_quota_gb type="NumericField">
                <Default>100</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100000</MaximumValue>
            </provider1_quota_gb>
            <provider1_cycle_day type="NumericField">
                <Default>1</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>31</MaximumValue>
            </provider1_cycle_day>
            <provider1_warning_percent type="NumericField">
                <Default>80</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100</MaximumValue>
            </provider1_warning_percent>
            <provider2_enabled type="BooleanField"><Default>1</Default><Required>Y</Required></provider2_enabled>
            <provider2_name type="TextField">
                <Default>ISP 2</Default>
                <Required>Y</Required>
            </provider2_name>
            <provider2_interface type="InterfaceField">
                <Default>opt1</Default>
                <Required>Y</Required>
            </provider2_interface>
            <provider2_quota_gb type="NumericField">
                <Default>100</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100000</MaximumValue>
            </provider2_quota_gb>
            <provider2_cycle_day type="NumericField">
                <Default>15</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>31</MaximumValue>
            </provider2_cycle_day>
            <provider2_warning_percent type="NumericField">
                <Default>80</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100</MaximumValue>
            </provider2_warning_percent>
            <provider3_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></provider3_enabled>
            <provider3_name type="TextField"><Default>ISP 3</Default><Required>Y</Required></provider3_name>
            <provider3_interface type="InterfaceField"><Default>wan</Default><Required>Y</Required></provider3_interface>
            <provider3_quota_gb type="NumericField"><Default>100</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>100000</MaximumValue></provider3_quota_gb>
            <provider3_cycle_day type="NumericField"><Default>1</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>31</MaximumValue></provider3_cycle_day>
            <provider3_warning_percent type="NumericField"><Default>80</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>100</MaximumValue></provider3_warning_percent>
            <provider4_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></provider4_enabled>
            <provider4_name type="TextField"><Default>ISP 4</Default><Required>Y</Required></provider4_name>
            <provider4_interface type="InterfaceField"><Default>wan</Default><Required>Y</Required></provider4_interface>
            <provider4_quota_gb type="NumericField"><Default>100</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>100000</MaximumValue></provider4_quota_gb>
            <provider4_cycle_day type="NumericField"><Default>1</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>31</MaximumValue></provider4_cycle_day>
            <provider4_warning_percent type="NumericField"><Default>80</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>100</MaximumValue></provider4_warning_percent>
            <consumers_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </consumers_enabled>
            <domain_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </domain_enabled>
            <top_limit type="NumericField">
                <Default>20</Default>
                <Required>Y</Required>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>100</MaximumValue>
            </top_limit>
            <default_period type="OptionField">
                <Default>thirty</Default>
                <Required>Y</Required>
                <OptionValues>
                    <today>Today</today>
                    <week>Last 7 days</week>
                    <thirty>Last 30 days</thirty>
                    <month>Current month</month>
                </OptionValues>
            </default_period>
            <domain_retention_days type="NumericField">
                <Default>90</Default>
                <Required>Y</Required>
                <MinimumValue>7</MinimumValue>
                <MaximumValue>365</MaximumValue>
            </domain_retention_days>
            <alerts_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </alerts_enabled>
            <projection_alert_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </projection_alert_enabled>
            <alert_repeat_hours type="NumericField">
                <Default>24</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>168</MaximumValue>
            </alert_repeat_hours>
        </general>
    </items>
</model>
