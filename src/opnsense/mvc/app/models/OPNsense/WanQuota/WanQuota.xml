            </provider2_name>
            <provider2_interface type="InterfaceField">
                <Default>opt1</Default>
                <Required>Y</Required>
            </provider2_interface>
            <provider2_quota_gb type="NumericField">
                <Default>100</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100000</MaximumValue>
            </provider2_quota_gb>
            <provider2_cycle_day type="NumericField">
                <Default>15</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>31</MaximumValue>
            </provider2_cycle_day>
            <provider2_warning_percent type="NumericField">
                <Default>80</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>100</MaximumValue>
            </provider2_warning_percent>
            <provider2_cycle_cost type="NumericField"><Default>0</Default><Required>Y</Required><MinimumValue>0</MinimumValue><MaximumValue>1000000</MaximumValue></provider2_cycle_cost>
            <provider2_baseline_gb type="NumericField"><Default>0</Default><Required>Y</Required><MinimumValue>0</MinimumValue><MaximumValue>100000</MaximumValue></provider2_baseline_gb>
            <provider2_baseline_cycle type="TextField"><Default></Default></provider2_baseline_cycle>
            <provider3_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></provider3_enabled>
            <provider3_name type="TextField"><Default>ISP 3</Default><Required>Y</Required></provider3_name>
            <provider3_interface type="InterfaceField"><Default>wan</Default><Required>Y</Required></provider3_interface>
            <provider3_quota_gb type="NumericField"><Default>100</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>100000</MaximumValue></provider3_quota_gb>
            <provider3_cycle_day type="NumericField"><Default>1</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>31</MaximumValue></provider3_cycle_day>
            <provider3_warning_percent type="NumericField"><Default>80</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>100</MaximumValue></provider3_warning_percent>
            <provider3_cycle_cost type="NumericField"><Default>0</Default><Required>Y</Required><MinimumValue>0</MinimumValue><MaximumValue>1000000</MaximumValue></provider3_cycle_cost>
            <provider3_baseline_gb type="NumericField"><Default>0</Default><Required>Y</Required><MinimumValue>0</MinimumValue><MaximumValue>100000</MaximumValue></provider3_baseline_gb>
            <provider3_baseline_cycle type="TextField"><Default></Default></provider3_baseline_cycle>
            <provider4_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></provider4_enabled>
            <provider4_name type="TextField"><Default>ISP 4</Default><Required>Y</Required></provider4_name>
            <provider4_interface type="InterfaceField"><Default>wan</Default><Required>Y</Required></provider4_interface>
            <provider4_quota_gb type="NumericField"><Default>100</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>100000</MaximumValue></provider4_quota_gb>
            <provider4_cycle_day type="NumericField"><Default>1</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>31</MaximumValue></provider4_cycle_day>
            <provider4_warning_percent type="NumericField"><Default>80</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>100</MaximumValue></provider4_warning_percent>
            <provider4_cycle_cost type="NumericField"><Default>0</Default><Required>Y</Required><MinimumValue>0</MinimumValue><MaximumValue>1000000</MaximumValue></provider4_cycle_cost>
            <provider4_baseline_gb type="NumericField"><Default>0</Default><Required>Y</Required><MinimumValue>0</MinimumValue><MaximumValue>100000</MaximumValue></provider4_baseline_gb>
            <provider4_baseline_cycle type="TextField"><Default></Default></provider4_baseline_cycle>
            <consumers_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </consumers_enabled>
            <domain_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </domain_enabled>
            <top_limit type="NumericField">
                <Default>20</Default>
                <Required>Y</Required>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>100</MaximumValue>
            </top_limit>
            <default_period type="OptionField">
                <Default>thirty</Default>
                <Required>Y</Required>
                <OptionValues>
                    <today>Today</today>
                    <week>Last 7 days</week>
                    <thirty>Last 30 days</thirty>
                    <month>Current month</month>
                </OptionValues>
            </default_period>
            <domain_retention_days type="NumericField">
                <Default>90</Default>
                <Required>Y</Required>
                <MinimumValue>7</MinimumValue>
                <MaximumValue>365</MaximumValue>
            </domain_retention_days>
            <alerts_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </alerts_enabled>
            <projection_alert_enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </projection_alert_enabled>
            <alert_repeat_hours type="NumericField">
                <Default>24</Default>
                <Required>Y</Required>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>168</MaximumValue>
            </alert_repeat_hours>
            <intelligence_enabled type="BooleanField"><Default>1</Default><Required>Y</Required></intelligence_enabled>
            <intelligence_retention_days type="NumericField"><Default>730</Default><Required>Y</Required><MinimumValue>30</MinimumValue><MaximumValue>3650</MaximumValue></intelligence_retention_days>
            <anomaly_sigma type="NumericField"><Default>3</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>10</MaximumValue></anomaly_sigma>
            <device_groups_json type="TextField"><Default>[]</Default><Required>Y</Required></device_groups_json>
            <device_policies_json type="TextField"><Default>[]</Default><Required>Y</Required></device_policies_json>
            <domain_categories_json type="TextField"><Default>{}</Default><Required>Y</Required></domain_categories_json>
            <enforcement_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></enforcement_enabled>
            <enforcement_dry_run type="BooleanField"><Default>1</Default><Required>Y</Required></enforcement_dry_run>
            <device_enforcement_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></device_enforcement_enabled>
            <device_enforcement_dry_run type="BooleanField"><Default>1</Default><Required>Y</Required></device_enforcement_dry_run>
            <shaper_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></shaper_enabled>
            <shaper_dry_run type="BooleanField"><Default>1</Default><Required>Y</Required></shaper_dry_run>
            <!--
                Upload shaping through ipfw's layer2 hook. Off by default and
                labelled experimental because it cannot go through the traffic
                shaper model: the model has no layer2 field, so the rules are raw
                ipfw and any ipfw reload removes them until the collector puts
                them back. Only useful where a netmap capture engine hides LAN
                ingress from the normal hook, which is the only case it is offered.
            -->
            <shaper_upload_experimental type="BooleanField"><Default>0</Default><Required>Y</Required></shaper_upload_experimental>
            <service_limits_json type="TextField"><Default>[]</Default><Required>N</Required></service_limits_json>
            <device_limits_json type="TextField"><Default>[]</Default><Required>N</Required></device_limits_json>
            <!--
                Manual internet blocks. Separate from device_policies_json because the
                two carry different authority: a budget is a standing rule evaluated
                against measurements, a block is an act taken now. Storing them together
                would mean an expiring block rewriting the file that holds budgets.
            -->
            <device_blocks_json type="TextField"><Default>[]</Default><Required>N</Required></device_blocks_json>
            <service_blocks_json type="TextField"><Default>[]</Default><Required>N</Required></service_blocks_json>
            <enforcement_policy type="OptionField"><Default>observe</Default><Required>Y</Required><OptionValues><observe>Observe only</observe><deprioritize>Deprioritize</deprioritize><failover>Failover only</failover><cutoff>Cut off at quota</cutoff></OptionValues></enforcement_policy>
            <guardrail_thresholds type="TextField"><Default>50,75,90,100</Default><Required>Y</Required></guardrail_thresholds>
            <emergency_reserve_gb type="NumericField"><Default>5</Default><Required>Y</Required><MinimumValue>0</MinimumValue><MaximumValue>100000</MaximumValue></emergency_reserve_gb>
            <!--
                Renewal-aware WAN balance. The guardrails answer "this link is running
                out"; this answers "this link's allowance is about to expire unspent",
                which on providers with different billing days is the more common waste.
                It only ever changes gateway weights, never tiers or force_down, so it
                cannot take a link out of service — that stays the guardrails' decision.
            -->
            <!--
                Which instrument the balancer may use. "weights" shares traffic and can
                never idle a link. "drain" additionally concentrates everything onto one
                provider when sharing would waste allowance — when a link could absorb
                the household's whole daily demand and still not spend its allowance
                before renewal. It releases itself when that stops being true, which
                happens at cycle renewal without anything being scheduled.
            -->
            <balance_mode type="OptionField"><Default>weights</Default><Required>Y</Required><OptionValues><weights>Share by weight only</weights><drain>Share, and concentrate when sharing would waste allowance</drain></OptionValues></balance_mode>
            <balance_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></balance_enabled>
            <balance_dry_run type="BooleanField"><Default>1</Default><Required>Y</Required></balance_dry_run>
            <!-- Empty auto-detects the only gateway group; required when there is more than one. -->
            <balance_group type="TextField"><Default></Default></balance_group>
            <!-- The weight the most urgent provider receives. Lower it to soften the ratio. -->
            <balance_max_weight type="NumericField"><Default>10</Default><Required>Y</Required><MinimumValue>2</MinimumValue><MaximumValue>10</MaximumValue></balance_max_weight>
            <webhook_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></webhook_enabled>
            <webhook_url type="TextField"><Default></Default></webhook_url>
            <webhook_format type="OptionField"><Default>generic</Default><Required>Y</Required><OptionValues><generic>Generic JSON</generic><discord>Discord</discord><slack>Slack</slack><telegram>Telegram Bot API</telegram></OptionValues></webhook_format>
            <webhook_recipient type="TextField"><Default></Default></webhook_recipient>
            <scheduled_reports_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></scheduled_reports_enabled>
            <email_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></email_enabled>
            <email_to type="TextField"><Default></Default></email_to>
            <smtp_host type="TextField"><Default></Default></smtp_host>
            <smtp_port type="NumericField"><Default>587</Default><Required>Y</Required><MinimumValue>1</MinimumValue><MaximumValue>65535</MaximumValue></smtp_port>
            <smtp_username type="TextField"><Default></Default></smtp_username>
            <smtp_password type="TextField"><Default></Default></smtp_password>
            <prometheus_enabled type="BooleanField"><Default>0</Default><Required>Y</Required></prometheus_enabled>
            <dashboard_accent type="TextField"><Default>#3b82f6</Default><Required>Y</Required><Mask>/^#[0-9a-fA-F]{6}$/</Mask></dashboard_accent>
        </general>
    </items>
</model>
