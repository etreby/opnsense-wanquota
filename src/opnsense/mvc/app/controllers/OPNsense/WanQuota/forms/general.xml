    <field>
        <id>wanquota.general.consumers_enabled</id>
        <label>Enable consumer reporting</label>
        <type>checkbox</type>
        <help>Rank LAN hosts using the persistent OPNsense Insight daily-flow database.</help>
    </field>
    <field>
        <id>wanquota.general.domain_enabled</id>
        <label>Enable domain attribution</label>
        <type>checkbox</type>
        <help>Correlate Insight flow bytes with recently observed Unbound DNS answers. Results are attributed estimates.</help>
    </field>
    <field>
        <id>wanquota.general.top_limit</id>
        <label>Top results</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.default_period</id>
        <label>Default consumer period</label>
        <type>dropdown</type>
    </field>
    <field>
        <id>wanquota.general.domain_retention_days</id>
        <label>DNS attribution retention (days)</label>
        <type>text</type>
    </field>
    <field>
        <id>wanquota.general.alerts_enabled</id>
        <label>Enable quota alerts</label>
        <type>checkbox</type>
        <help>Write deduplicated threshold and projection alerts to the system log.</help>
    </field>
    <field>
        <id>wanquota.general.projection_alert_enabled</id>
        <label>Alert when projected usage exceeds quota</label>
        <type>checkbox</type>
    </field>
    <field>
        <id>wanquota.general.alert_repeat_hours</id>
        <label>Alert repeat interval (hours)</label>
        <type>text</type>
    </field>
    <field><id>wanquota.general.intelligence_enabled</id><label>Enable intelligence history and analytics</label><type>checkbox</type></field>
    <field><id>wanquota.general.intelligence_retention_days</id><label>Analytics retention (days)</label><type>text</type></field>
    <field><id>wanquota.general.anomaly_sigma</id><label>Anomaly sensitivity (standard deviations)</label><type>text</type><help>Lower values detect more deviations. Three is a conservative default.</help></field>
    <field><id>wanquota.general.device_groups_json</id><label>Device groups (JSON)</label><type>text</type><help>Array of objects with name, members (IP/CIDR list), and optional budget_gb.</help></field>
    <field><id>wanquota.general.device_policies_json</id><label>Per-device policies (JSON)</label><type>text</type><help>Array of objects with address, optional budget_gb, and exclude true/false.</help></field>
    <field><id>wanquota.general.domain_categories_json</id><label>Custom domain categories (JSON)</label><type>text</type><help>Object mapping category names to domain-suffix arrays. Built-in categories remain available.</help></field>
    <field><id>wanquota.general.enforcement_enabled</id><label>Enable automatic guardrail enforcement</label><type>checkbox</type><help>Requires dry-run to be disabled and a non-observe policy. Leave disabled until recommendations are verified.</help></field>
    <field><id>wanquota.general.enforcement_dry_run</id><label>Guardrail dry-run mode</label><type>checkbox</type></field>
    <field>
      <id>wanquota.general.device_enforcement_enabled</id>
      <label>Per-device budget enforcement</label>
      <type>checkbox</type>
      <help>Block individual devices that exceed their configured budget, by maintaining the wanquota_over_budget firewall table. Requires a firewall rule that blocks that table. The router, devices marked excluded, and members of a protected infrastructure group are never blocked.</help>
    </field>
    <field>
      <id>wanquota.general.device_enforcement_dry_run</id>
      <label>Per-device dry-run mode</label>
      <type>checkbox</type>
      <help>Record which devices would be blocked without changing the firewall table. Leave enabled until the recorded membership matches what you intend to block.</help>
    </field>
    <field>
      <id>wanquota.general.shaper_enabled</id>
      <label>Per-service bandwidth limits</label>
      <type>checkbox</type>
      <help>Cap named streaming services to a chosen rate using the OPNsense traffic shaper. Addresses come from recently observed DNS answers, so a device using encrypted DNS, a VPN or ECH is not matched and streams uncapped.</help>
    </field>
    <field>
      <id>wanquota.general.shaper_dry_run</id>
      <label>Per-service limits dry-run mode</label>
      <type>checkbox</type>
      <help>Record the pipes and rules that would be created without touching the shaper. Leave enabled until the recorded plan matches what you intend to limit.</help>
    </field>
    <field>
      <id>wanquota.general.service_limits_json</id>
      <label>Per-service limits</label>
      <type>textbox</type>
      <help>JSON array, for example [{"service":"netflix","resolution":"1080p"},{"service":"youtube","mbit":3}]. Use resolution for a published rate (4k 15, 1080p 5, 720p 3, 480p 1.5, audio_only 0.5 Mbit/s) or mbit for an exact figure. A cap bounds what a player can sustain; it does not select a resolution.</help>
    </field>
    <field><id>wanquota.general.enforcement_policy</id><label>Maximum automatic policy</label><type>dropdown</type></field>
    <field><id>wanquota.general.guardrail_thresholds</id><label>Guardrail thresholds (%)</label><type>text</type></field>
    <field><id>wanquota.general.emergency_reserve_gb</id><label>Emergency reserve (GB)</label><type>text</type></field>
    <field><id>wanquota.general.webhook_enabled</id><label>Enable HTTPS webhook notifications</label><type>checkbox</type></field>
    <field><id>wanquota.general.webhook_url</id><label>Webhook URL</label><type>text</type></field>
    <field><id>wanquota.general.webhook_format</id><label>Webhook format</label><type>dropdown</type></field>
    <field><id>wanquota.general.webhook_recipient</id><label>Webhook recipient / Telegram chat ID</label><type>text</type></field>
    <field><id>wanquota.general.scheduled_reports_enabled</id><label>Enable scheduled webhook reports</label><type>checkbox</type></field>
    <field><id>wanquota.general.email_enabled</id><label>Enable SMTP email notifications</label><type>checkbox</type></field>
    <field><id>wanquota.general.email_to</id><label>Email recipient</label><type>text</type></field>
    <field><id>wanquota.general.smtp_host</id><label>SMTP host</label><type>text</type></field>
    <field><id>wanquota.general.smtp_port</id><label>SMTP STARTTLS port</label><type>text</type></field>
    <field><id>wanquota.general.smtp_username</id><label>SMTP username</label><type>text</type></field>
    <field><id>wanquota.general.smtp_password</id><label>SMTP password</label><type>password</type></field>
    <field><id>wanquota.general.prometheus_enabled</id><label>Enable Prometheus metrics output</label><type>checkbox</type></field>
    <field><id>wanquota.general.dashboard_accent</id><label>Dashboard accent color</label><type>text</type></field>
</form>
